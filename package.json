{
  "name": "legax",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "generate-types": "wrangler types",
    "typecheck": "npm run generate-types && tsc --noEmit",
    "build": "npm run generate-types && wrangler deploy --dry-run --outdir dist",
    "test": "npm run typecheck && node --test tests/smoke.test.mjs",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.102.0"
  }
}
