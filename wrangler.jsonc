{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legax",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "env": {
    "staging": {
      "name": "legax-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "legax",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "routes": [
        {
          "pattern": "legax.dev",
          "custom_domain": true,
          "zone_name": "legax.dev"
        }
      ]
    }
  }
}
